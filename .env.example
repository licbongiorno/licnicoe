# URL pública definitiva (sin barra final). Se usa en canonical, sitemap y Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.nicolasespindola.com.ar

# Analítica (opcional, completar solo una o ambas). Si quedan vacías, no se carga ningún script.
# Google Analytics 4 — ID de medición (G-XXXXXXX)
NEXT_PUBLIC_GA_ID=
# Plausible (sin cookies) — dominio registrado en Plausible
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Verificación de Google Search Console (solo el código del meta tag)
NEXT_PUBLIC_GSC_VERIFICATION=
